# =============================================================================
# BoosterApp — environment variables
# =============================================================================
# Copy this file to .env.local for local development:  cp .env.example .env.local
# For Vercel: add each of these in Project Settings → Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle. Everything
# else is server-only and never leaves the Node runtime.

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------

# Set to "1" to run the app in demo mode: the middleware bypasses Supabase and
# the home route redirects to /demo. Use "0" (or leave unset) for production.
NEXT_PUBLIC_DEMO_MODE=0

# -----------------------------------------------------------------------------
# Supabase — required
# -----------------------------------------------------------------------------

# Project URL, e.g. https://<ref>.supabase.co
# Get from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Anon JWT (public). Used by the browser client and the chat widget.
# Get from: Supabase dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (secret). Used by API routes that bypass RLS:
#   - /api/webhook/message       (n8n inserts conversations/messages)
#   - /api/webhook/hotel-config  (n8n reads the hotel's bot config)
#   - /api/cron/archive          (Vercel Cron archives old conversations)
#   - lib/widget-broadcast       (push staff replies to Realtime channels)
# NEVER expose this in the browser bundle.
# Get from: Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Shared secrets
# -----------------------------------------------------------------------------

# Shared secret n8n MUST send as `x-webhook-secret` header to call any of:
#   /api/webhook/message, /api/webhook/hotel-config, /api/push/send,
#   /api/cron/archive (also accepts CRON_SECRET via Authorization: Bearer)
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to the
# cron endpoint. You can reuse WEBHOOK_SECRET or pick a separate random value
# (recommended in production so rotating one doesn't break the other).
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# -----------------------------------------------------------------------------
# Web Push (VAPID) — required for receptionist push notifications
# -----------------------------------------------------------------------------

# Public VAPID key. Browser uses it when registering a push subscription.
# Generate both keys with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private VAPID key. Server signs each push payload with it.
VAPID_PRIVATE_KEY=

# Contact email for VAPID (the push provider may reach you about abuse).
VAPID_EMAIL=hola@boosterlab.studio

# -----------------------------------------------------------------------------
# Anthropic — required for AI-powered features
# -----------------------------------------------------------------------------

# Claude API key. Used by:
#   - /api/leads/analyze              (Lead scoring on conversations)
#   - /api/dashboard/weekly-summary   (Weekly AI summary in /dashboard)
# If unset, both endpoints return HTTP 503 with a Spanish error message and
# the rest of the app continues to work.
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Embed snippet — optional
# -----------------------------------------------------------------------------

# Public URL of the chat-widget JS file. If unset, the /settings → Apariencia
# tab builds the install snippet using the app's own origin
# (e.g. https://your-app.vercel.app/widget/v1.js).
NEXT_PUBLIC_WIDGET_URL=

# =============================================================================
# Script-only (NOT needed at runtime, do NOT set in Vercel)
# =============================================================================

# Supabase Personal Access Token. Only used by scripts/apply-migration.mjs to
# call the Management API. Get from: https://supabase.com/dashboard/account/tokens
# SUPABASE_PAT=
